Options -MultiViews

RewriteEngine On
RewriteBase /

# HTTPS Redirect
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Existing files/directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Exclude Next.js static assets and media/font files from any further rewrites
RewriteCond %{REQUEST_URI} ^/_next/ [OR]
RewriteCond %{REQUEST_URI} \.(css|js|gif|png|jpg|jpeg|svg|ico|webp|woff|woff2|eot|ttf|otf)$ [NC]
RewriteRule ^ - [L]

# Next.js static export RSC payload routing (requests with _rsc query parameter)
RewriteCond %{QUERY_STRING} (^|&)_rsc=
RewriteRule ^([^/]+)/?$ /$1/index.txt [L,T=text/plain]

RewriteCond %{QUERY_STRING} (^|&)_rsc=
RewriteRule ^([^/]+)/([^/]+)/?$ /$1/$2/index.txt [L,T=text/plain]

RewriteCond %{QUERY_STRING} (^|&)_rsc=
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ /$1/$2/$3/index.txt [L,T=text/plain]

# Next.js static export HTML routing
RewriteRule ^([^/]+)/?$ /$1/index.html [L]
RewriteRule ^([^/]+)/([^/]+)/?$ /$1/$2/index.html [L]
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ /$1/$2/$3/index.html [L]

RewriteRule ^$ /index.html [L]

# Cache-Control headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
